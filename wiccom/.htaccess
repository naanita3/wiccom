# ===== Wiccom · Apache =====
Options -Indexes
DirectoryIndex index.html
# Hay páginas y carpetas con el mismo nombre (marcas.html y marcas/): no agregar "/" automáticamente
DirectorySlash Off
ErrorDocument 404 /404.html

RewriteEngine On
# Forzar HTTPS y dominio con www (igual que el canonical y el sitemap)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.wiccom.com.mx%{REQUEST_URI} [L,R=301]

# Páginas del sitio anterior -> página equivalente del sitio nuevo (301 permanente)
RewriteRule ^(index_|index__resp[^/]*|work4)\.html$ / [R=301,L,NC]
RewriteRule ^preguntasfrecuentes(\.html)?$ /preguntas-frecuentes [R=301,L,NC]
RewriteRule ^(seguridadelectronica|videovigilanc[^/]*)\.html$ /soluciones/videovigilancia [R=301,L,NC]
RewriteRule ^videoportero[^/]*\.html$ /soluciones/control-de-acceso [R=301,L,NC]
RewriteRule ^(redeswireless|telefonia)\.html$ /soluciones/redes-y-telecomunicaciones [R=301,L,NC]
RewriteRule ^seguridadenredes\.html$ /soluciones/ciberseguridad [R=301,L,NC]
RewriteRule ^serviciotecnico\.html$ /servicios/soporte-tecnico [R=301,L,NC]
RewriteRule ^(servidoresdewindows|sistemas|facturaelectronica|soft_[^/]*)\.html$ /soluciones/computo-y-ti [R=301,L,NC]

# /pagina.html  ->  /pagina   (URL limpia)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]
RewriteRule ^index$ / [R=301,L]
# /pagina/  ->  /pagina   (si existe pagina.html; p. ej. /marcas/ o /soluciones/)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/$ /$1 [R=301,L]
# /pagina  ->  sirve pagina.html (también cuando existe una carpeta con el mismo nombre)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)$ $1.html [L]

AddType font/woff2 .woff2

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json application/xml text/plain
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# No publicar el generador ni la documentación interna
RewriteRule ^(_generador|README\.md|IMAGENES\.md) - [F,L]
